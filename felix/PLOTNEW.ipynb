    "    Rv = np.asarray(Rv, dtype=float)\n",
    "    N1 = np.asarray(N1, dtype=float)\n",
    "    N2 = np.asarray(N2, dtype=float)\n",
    "\n",
    "    Rmax = np.max(Rv)\n",
    "    if not np.isfinite(Rmax) or Rmax <= 0:\n",
    "        return np.full_like(f_grid, np.inf, dtype=float)\n",
    "\n",
    "    thr = max(abs_thr, rel_thr * Rmax)\n",
