    "    om = np.full_like(f_grid, np.inf, dtype=float)\n",
    "    mask = (Rv > thr) & np.isfinite(Rv) & np.isfinite(N1) & np.isfinite(N2)\n",
    "    if np.any(mask):\n",
    "        om[mask] = omega_channel_channel_tilde(f_grid[mask], Rv[mask], N1[mask], N2[mask])\n",
    "    return om"
